# Copy to backend/.env and fill in. That file is gitignored; this one
# is tracked, so never put a real credential here.
#
#   cp backend/.env.example backend/.env

# ── Database ──────────────────────────────────────────────────
# The local Postgres from the README's docker line. Schema lives in
# backend/srs/data_structure.sql:
#
#   docker run -d --name jp-db -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
#   docker exec -i jp-db psql -U postgres -c "CREATE DATABASE jp;"
#   docker exec -i jp-db psql -U postgres -d jp < backend/srs/data_structure.sql
DATABASE_URL=postgresql://postgres:dev@localhost:5432/jp

# ── Auth, local ───────────────────────────────────────────────
# Set this and the two Supabase values below can stay empty: every
# request is treated as this user and no token is verified. See the
# comment in core/auth.py for why this exists and why it is safe to
# ship as an unset variable.
#
# Any string works — it is the user_id every row gets keyed to, so
# keep the same one between runs or your data appears to vanish.
DEV_USER_ID=local-dev-user

# ── Auth, real ────────────────────────────────────────────────
# Only needed when DEV_USER_ID is unset. SUPABASE_SERVICE_KEY is the
# service-role key: it bypasses row-level security on the whole
# project, so treat it like a database password and never paste it
# into a chat, an issue, or a commit.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated origins allowed *in addition to* the deployed
# frontend, which is always permitted. This is where a local Vite dev
# server goes; Vite picks the first free port from 5173 upward, so
# list the ones you actually use.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Exam audio storage ────────────────────────────────────────
# Where study/exam_tts.py writes generated listening-section MP3s and
# main.py serves them from (both must agree — see study/exam_tts.py's
# own comment). On Render this must be set to the persistent disk's
# mount path (render.yaml mounts one at /data) or every generated
# audio file is silently lost on the next deploy while the URL
# referencing it stays baked into the stored exam paper forever.
# Leave unset locally — it falls back to backend/datas/exam_audio.
EXAM_AUDIO_DIR=

# ── LLM providers ─────────────────────────────────────────────
# Exam generation, reading comprehension and phrase analysis all go
# through study/llm_shared.py's chat(), which tries providers in order
# and falls over to the next one when an account is out. Set at least
# one key; anything left empty is dropped from the list rather than
# tried and failed.
#
# NVIDIA NIM (https://build.nvidia.com) — OpenAI-compatible, key starts
# with "nvapi-". Free tier at time of writing: 1,000 inference credits
# (+4,000 on request), 40 requests/minute, phone verification required,
# and explicitly NO production SLA. Fine as a development and backup
# provider; do not treat it as unlimited.
#
# Both spellings are read, because the key was first added under the
# misspelled name and silently ignoring a key that is right there is
# worse than accepting two names. Either works.
NVDIA_API_KEY=
# NVIDIA_API_KEY=

# OpenRouter (https://openrouter.ai) — key starts with "sk-or-".
OPENROUTER_API_KEY=

# Which providers to try, in order. Defaults to "nvidia,openrouter".
# Flip it to put OpenRouter back in front without touching code, or
# name a single provider to pin generation to it.
# LLM_PROVIDER_ORDER=nvidia,openrouter

# Overrides only the FIRST model in the OpenRouter list. Leave unset
# unless you are deliberately pinning one -- a stale value here once
# pointed at a model that had moved off the free tier, and every call
# paid a 404 for it. Verify any change with:
#
#   python -m scripts.check_llm_models          # do the ids still exist?
#   python -m scripts.check_llm_models --smoke  # do they still write Japanese?
# OPENROUTER_MODEL=

# ── Optional: make the YouTube URL ingest work from a datacenter ──
# YouTube blocks datacenter IPs for its caption endpoints, so on Render
# the URL path always fails and learners use the paste or upload ingest
# instead -- both work with no configuration and no third party. The
# same fetch succeeds from a residential IP, so this is about WHERE the
# request comes from, not about the code.
#
# Setting either pair below routes caption fetches through a proxy,
# which is the only thing that makes URLs work from a deployed server.
# Entirely optional: leave unset and nothing else changes. Expect it to
# degrade over time -- YouTube escalates -- which is why nothing here
# depends on it.
#
# Set these in the Render dashboard, never in a tracked file.
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# YOUTUBE_HTTP_PROXY=
# YOUTUBE_HTTPS_PROXY=
