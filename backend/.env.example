# Copy to backend/.env and fill in. That file is gitignored; this one
# is tracked, so never put a real credential here.
#
#   cp backend/.env.example backend/.env

# ── Database ──────────────────────────────────────────────────
# The local Postgres from the README's docker line. Schema lives in
# backend/srs/data_structure.sql:
#
#   docker run -d --name jp-db -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
#   docker exec -i jp-db psql -U postgres -c "CREATE DATABASE jp;"
#   docker exec -i jp-db psql -U postgres -d jp < backend/srs/data_structure.sql
DATABASE_URL=postgresql://postgres:dev@localhost:5432/jp

# ── Auth, local ───────────────────────────────────────────────
# Set this and the two Supabase values below can stay empty: every
# request is treated as this user and no token is verified. See the
# comment in core/auth.py for why this exists and why it is safe to
# ship as an unset variable.
#
# Any string works — it is the user_id every row gets keyed to, so
# keep the same one between runs or your data appears to vanish.
DEV_USER_ID=local-dev-user

# ── Auth, real ────────────────────────────────────────────────
# Only needed when DEV_USER_ID is unset. SUPABASE_SERVICE_KEY is the
# service-role key: it bypasses row-level security on the whole
# project, so treat it like a database password and never paste it
# into a chat, an issue, or a commit.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated origins allowed *in addition to* the deployed
# frontend, which is always permitted. This is where a local Vite dev
# server goes; Vite picks the first free port from 5173 upward, so
# list the ones you actually use.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
