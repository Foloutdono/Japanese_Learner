{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os, uvicorn; uvicorn.run('main:app', port=int(os.environ.get('PORT', '8000')))"
      ],
      "cwd": "backend",
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "frontend-sounds",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5183"
      ],
      "cwd": "frontend",
      "port": 5183,
      "autoPort": false
    }
  ]
}
