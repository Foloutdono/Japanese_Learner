<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- allowBackup is off: the learner's session (the Supabase tokens
         @capacitor/preferences keeps, src/lib/authStorage.js) is not
         copied into a cloud backup or out over adb, and everything else
         the app knows is the server's. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 改札 — where Supabase sends the learner back after Google
                 (src/lib/oauth.js's NATIVE_REDIRECT). Google itself never
                 sees this scheme: it redirects to the Supabase project's
                 own callback, and Supabase redirects here, which is why a
                 custom scheme is allowed at all. The same string has to
                 be in Supabase's Redirect URLs allowlist.
                 launchMode is already singleTask above, so this arrives
                 on the running Activity as onNewIntent (Capacitor's App
                 plugin turns it into appUrlOpen) rather than starting a
                 second copy of the app over the first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.tsuji" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- 発車案内 — the day's train on the home screen (plan 156,
             TrainWidget.java). The system alone sends it updates, so it
             is not exported; a tap opens MainActivity explicitly with
             app.tsuji://open/today, its Depart with app.tsuji://open/run
             (plan 293), which need no intent filter. -->
        <receiver
            android:name=".TrainWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_train_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- 写真 — the photo picker on Android 7 to 10, which have none of
             their own: this asks Play services to install its backport,
             which PhotoChromeClient's picker then opens. Never enabled;
             the class is Play services', not the app's. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value="" />
        </service>
    </application>

    <!-- Permissions. INTERNET is the app, POST_NOTIFICATIONS the daily
         nudge (@capacitor/local-notifications, plan 075). Nothing else:
         - No camera permission: the analyzer's Shoot (<input type=file
           capture>) hands the shot to the camera app, which needs none
           from us, and declaring it would only put a prompt before it.
         - No media permission: a photo is chosen in the system photo
           picker (PhotoChromeClient), which hands the app the one picture.
           Never add READ_MEDIA_IMAGES back: Google Play refuses it to an
           app that reads a photo now and then.
         - No exact alarms: the plugin declares SCHEDULE_EXACT_ALARM, which
           Google Play keeps for alarm clocks and calendars; a study
           reminder may come a few minutes late (src/lib/native.js asks
           for none), so it is taken out of the merged manifest here. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <!-- The camera app, made visible to Capacitor's chooser: since Android
         11 an app sees only the apps it names here, and without this the
         Shoot found no camera and opened the file browser instead. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
