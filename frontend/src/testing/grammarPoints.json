 {
  "type": "grammar",
  "raw_id": "grammar_N5_は",
  "level": "N5",
  "pattern": "は",
  "structure": "topic + は",
  "meaning": "marque le thème de la phrase",
  "register": null,
  "steps": [
   {
    "kind": "rule",
    "text": "**は** marque le thème : ce dont la phrase parle. Tout ce qui suit est un commentaire sur ce thème."
   },
   {
    "kind": "use",
    "text": "- Pour poser ce dont on parle : わたしは, 今日は, この本は.\n- Pour opposer deux choses : 魚は食べますが、にくは食べません.\n- S'écrit は mais se lit « wa » dans ce rôle."
   },
   {
    "kind": "careful",
    "text": "は n'est pas « le sujet ». Un mot interrogatif (だれ, 何) ne prend jamais は, car il ne peut pas être une chose déjà connue : sujet, il prend が ; sinon, sa propre particule (何を食べますか)."
   }
  ],
  "compare": [
   {
    "pattern": "が",
    "raw_id": "grammar_N5_が",
    "level": "N5",
    "meaning": "marque le sujet grammatical",
    "text": "は pose ce dont on parle ; が pointe qui ou quoi fait l'action, ou une information nouvelle."
   },
   {
    "pattern": "も",
    "raw_id": "grammar_N5_も",
    "level": "N5",
    "meaning": "aussi, également",
    "text": "は pose un thème ; も l'ajoute au précédent : « aussi »."
   }
  ],
