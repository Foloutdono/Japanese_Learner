{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --mode native --outDir dist-native",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "npm run cap:sync && cap run android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "assets:native": "capacitor-assets generate --android --ios --iconBackgroundColor '#100e13' --iconBackgroundColorDark '#100e13' --splashBackgroundColor '#17151a' --splashBackgroundColorDark '#17151a'",
    "icons": "node scripts/render-icon.mjs && pwa-assets-generator && node scripts/place-icons.mjs",
    "lint": "eslint .",
    "lint:css": "node scripts/stylelint-ratchet.mjs",
    "lint:css:report": "stylelint \"src/**/*.css\"",
    "lint:scale": "node scripts/check-design-scale.mjs",
    "lint:ink": "node scripts/check-ink-ground.mjs",
    "lint:artboards": "node scripts/check-artboards.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.106.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.11.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.1",
    "prop-types": "^15.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
