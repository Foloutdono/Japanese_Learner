<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 発車案内 (plan 156): the App Group the app and its widget share, the
	     one place the widget can read the day's figures from. It has to be
	     registered in the Apple Developer account and enabled on both App
	     IDs before a build can be signed (docs/release.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.tsuji</string>
	</array>
</dict>
</plist>
