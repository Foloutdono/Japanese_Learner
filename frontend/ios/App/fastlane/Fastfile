# ── 出発 — the iOS lane (plan 077) ─────────────────────────────
# One lane, `beta`: sign with match, archive with gym, upload with
# pilot. Runs on the macOS runner of .github/workflows/mobile.yml on a
# `v*` tag; the version comes from the tag and the build number from
# the workflow run, so two uploads never collide. Everything secret
# arrives in the environment (see docs/release.md for the list).
default_platform(:ios)

platform :ios do
  desc "Archive the app and push it to TestFlight"
  lane :beta do
    # The App Store Connect API key, from the three secrets: no Apple ID,
    # no two-factor prompt, no session to expire mid-run.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    # A throwaway keychain on the runner: match needs one to import into,
    # and the login keychain of a hosted macOS runner is locked.
    setup_ci

    match(
      type: "appstore",
      api_key: api_key,
      readonly: false
    )

    increment_version_number(
      version_number: ENV.fetch("MARKETING_VERSION", "1.0.0"),
      xcodeproj: "App.xcodeproj"
    )
    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER", "1"),
      xcodeproj: "App.xcodeproj"
    )

    # match wrote the profile's name into the environment as
    # sigh_<bundle id>_appstore_profile-name; the archive signs with it.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_app.tsuji_appstore_profile-name")
    )

    # Capacitor 8 wires its plugins through Swift Package Manager
    # (ios/App/CapApp-SPM), so there is no CocoaPods workspace: the
    # project itself is what gym archives.
    gym(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "output",
      clean: true
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "Build #{ENV.fetch('BUILD_NUMBER', '1')} from the mobile workflow."
    )
  end
end
