# ── 出発 — the iOS lane (plan 077) ─────────────────────────────
# One lane, `beta`: sign with match, archive with gym, upload with
# pilot. Runs on the macOS runner of .github/workflows/mobile.yml on a
# `v*` tag; the version comes from the tag and the build number from
# the workflow run, so two uploads never collide. Everything secret
# arrives in the environment (see docs/release.md for the list).
default_platform(:ios)

platform :ios do
  desc "Archive the app and push it to TestFlight"
  lane :beta do
    # The key secret is the .p8 file, pasted as it is or in base64; either
    # is read back into the PEM OpenSSL wants, its body rewrapped, so a
    # paste that lost its line breaks still reads. Anything else (empty,
    # another file) stops here and names the secret, where it used to
    # reach OpenSSL as "invalid curve name" (every tag up to v1.1.4).
    key_secret = ENV.fetch("APP_STORE_CONNECT_KEY_P8", "").strip
    key_text = key_secret.include?("BEGIN PRIVATE KEY") ? key_secret : key_secret.unpack1("m")
    key_body = key_text[/-----BEGIN PRIVATE KEY-----(.+?)-----END PRIVATE KEY-----/m, 1]
    unless key_body
      UI.user_error!("APP_STORE_CONNECT_KEY_P8 is not the .p8 key: paste the whole " \
                     "AuthKey_XXXX.p8 file, from -----BEGIN PRIVATE KEY----- to " \
                     "-----END PRIVATE KEY-----, see docs/release.md")
    end
    key_pem = "-----BEGIN PRIVATE KEY-----\n" \
              "#{key_body.gsub(/\s+/, '').scan(/.{1,64}/).join("\n")}\n" \
              "-----END PRIVATE KEY-----\n"

    # The version comes from the tag (v1.2.3 is 1.2.3), the build number
    # from the workflow run. Refused here when malformed rather than
    # archived and turned away by App Store Connect.
    version = ENV.fetch("MARKETING_VERSION", "").delete_prefix("v")
    build = ENV.fetch("BUILD_NUMBER", "")
    UI.user_error!("MARKETING_VERSION must be a tag like v1.2.3, got #{ENV['MARKETING_VERSION'].inspect}") unless version.match?(/\A\d+\.\d+\.\d+\z/)
    UI.user_error!("BUILD_NUMBER must be a whole number, got #{build.inspect}") unless build.match?(/\A\d+\z/)

    # The App Store Connect API key, from the three secrets: no Apple ID,
    # no two-factor prompt, no session to expire mid-run.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: key_pem,
      is_key_content_base64: false,
      in_house: false
    )

    # A throwaway keychain on the runner: match needs one to import into,
    # and the login keychain of a hosted macOS runner is locked.
    setup_ci

    match(
      type: "appstore",
      api_key: api_key,
      readonly: false
    )

    # match wrote each profile's name into the environment as
    # sigh_<bundle id>_appstore_profile-name; each target signs with its
    # own -- the app, and the widget extension it embeds (plan 156).
    profiles = {
      "App" => ["app.tsuji", ENV.fetch("sigh_app.tsuji_appstore_profile-name")],
      "TsujiWidget" => ["app.tsuji.widget", ENV.fetch("sigh_app.tsuji.widget_appstore_profile-name")]
    }
    profiles.each do |target, (bundle_id, profile)|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "App.xcodeproj",
        targets: [target],
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        bundle_identifier: bundle_id,
        profile_name: profile
      )
    end

    # Capacitor 8 wires its plugins through Swift Package Manager
    # (ios/App/CapApp-SPM), so there is no CocoaPods workspace: the
    # project itself is what gym archives.
    gym(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: profiles.values.to_h
      },
      output_directory: "output",
      clean: true,
      # The version and build set on the command line, not by agvtool:
      # both targets' Info.plists read $(MARKETING_VERSION) and
      # $(CURRENT_PROJECT_VERSION), so the app and the widget it embeds
      # carry the same pair (App Store Connect refuses an extension whose
      # version differs from its app's), and the project needs none of
      # the Apple Generic Versioning that agvtool asks for and it lacks.
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}"
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "Build #{build} (#{version}) from the mobile workflow."
    )
  end
end
