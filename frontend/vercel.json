{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://japanese-learner.onrender.com/api/:path*"
    },
    {
      "source": "/kanjivg/:path*",
      "destination": "https://japanese-learner.onrender.com/kanjivg/:path*"
    },
    {
      "source": "/exam-audio/:path*",
      "destination": "https://japanese-learner.onrender.com/exam-audio/:path*"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
