{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://japanese-learner.onrender.com/api/:path*"
    },
    {
      "source": "/kanjivg/:path*",
      "destination": "https://japanese-learner.onrender.com/kanjivg/:path*"
    },
    {
      "source": "/exam-audio/:path*",
      "destination": "https://japanese-learner.onrender.com/exam-audio/:path*"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/",
      "destination": "/landing/index.html"
    },
    {
      "source": "/en",
      "destination": "/landing/en/index.html"
    },
    {
      "source": "/en/",
      "destination": "/landing/en/index.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing/en",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/landing/en/",
      "destination": "/en",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
