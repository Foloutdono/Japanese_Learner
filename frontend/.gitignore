# Local env overrides. .env.production is deliberately tracked (VITE_
# vars ship to the browser by design and it carries only the anon key)
# — these are the per-machine ones, e.g. VITE_API_URL pointing at a
# local backend.
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*storybook.log
storybook-static

# Throwaway Playwright probes and their screenshots
shot*.mjs
sweep*.mjs
probe*.mjs
shots/
